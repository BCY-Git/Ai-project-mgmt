# 生产环境配置（复制为 .env.prod 后再改）

# ─── 应用 ───────────────────────────────────
NODE_ENV=production
APP_PORT=3000
APP_SECRET=your_app_secret_32chars_here_please_change

# ─── JWT ────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_please_change
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_please_change
JWT_REFRESH_EXPIRES=7d

# ─── PostgreSQL ─────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_project_mgmt_prod
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# ─── Redis ──────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ─── AI ─────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_MODEL=claude-opus-4-20250514
AI_MAX_TOKENS=4096

# ─── 前端 ───────────────────────────────────
# 生产下建议同域反代，使用相对路径
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=

# ─── 可选扩展配置 ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# ─── 与 1Panel 共存（宿主机 80/443 被 OpenResty 占用）────────────────
# 在 .env.prod 增加下面三行（勿再用第二个 compose 文件合并端口，否则会重复映射 443）：
# NGINX_PUBLISH_HTTP=8082
# NGINX_PUBLISH_HTTPS=8443
# NGINX_CONF_PATH=./nginx/nginx.coexist-1panel.conf
# 然后：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# 浏览器：https://服务器IP:8443

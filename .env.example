# ─── 应用 ───────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_SECRET=your_app_secret_32chars_here_please_change

# ─── JWT ────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_please_change

DB_USER=postgres
DB_PASSWORD=postgres123

# ─── Redis ──────────────────────────────────
REDIS_HOST=localhost       # docker 内改为 redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ─── AI ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
